# --- Secrets and live data: never commit these -----------------------------
# .env holds JWT_SECRET, which is also the Fernet key for stored SSH credentials.
.env
.env.*
!.env.example

# SQLite database: encrypted SSH credentials, real server inventory, audit log.
data/
*.db
*.db-wal
*.db-shm

# Backups contain a copy of .env alongside a database dump.
backups/

# --- Python ----------------------------------------------------------------
.venv/
.venv-desktop/
venv/
# PyInstaller desktop build output (desktop/inframonitor.spec)
/build/
/dist/
# Inno Setup installer output (desktop/build-installer.ps1)
/dist-installer/
# icon preview render (the .ico itself is committed; the PNG is just for eyeballing)
desktop/inframonitor-preview.png
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Node / Next.js --------------------------------------------------------
node_modules/
frontend/node_modules/
# Built static UI: regenerated by `npm run build`, not source.
frontend/out/
frontend/.next/
frontend/next-env.d.ts
npm-debug.log*
yarn-error.log*

# --- Local scratch / OS / editor -------------------------------------------
tmp/
*.log
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# TypeScript incremental build cache
*.tsbuildinfo

# Monitoring http_sd bearer token (created per-deploy, matches MONITORING_SD_TOKEN)
monitoring/prometheus/sd_token

# Local credential scratch file -- never commit.
.secrets

# The fleet mapping sheet: internal hostnames/IPs, not part of the product.
Static Mapping.csv

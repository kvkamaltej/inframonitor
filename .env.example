# Infra Monitor configuration.
#
# Copy this file to .env and set JWT_SECRET before the first start:
#     cp .env.example .env
# scripts/deploy.sh generates a secret for you if .env does not exist yet.
#
# ===========================================================================
# BLOCK 1 -- LITE. If you are running the lite profile, this is all you need.
# ===========================================================================
# Lite is the default and takes no flags:
#     docker compose up -d          (or: scripts/stack.sh lite up)
# One container, SQLite, no monitoring. Everything in BLOCK 2 is ignored.

# Host port that the UI and the API are published on. The container always
# listens on 8000 internally; only this host-side port is configurable.
APP_PORT=8088

# REQUIRED. There is no default -- docker compose refuses to start without it.
# Generate a value with:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# WARNING: this one value does two jobs. It signs JWTs *and* it derives the
# Fernet key that encrypts every SSH credential stored in the database. If you
# change it after servers have been added, those stored credentials become
# permanently undecryptable and every server's credentials must be re-entered.
# Treat it as part of the backup set: back it up together with the database
# (scripts/backup.sh saves both, for exactly this reason).
JWT_SECRET=REPLACE_ME_generate_a_secret_with_the_command_above

# Lifetime of an issued access token, in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Leave empty for the normal setup. The UI is served by the same process as the
# API, so requests are same-origin and need no CORS headers. Only set this --
# as a comma-separated list of origins -- if you serve the API to a UI hosted
# somewhere else.
CORS_ORIGINS=

# The account created on first boot, in an empty database.
#
# While the admin password is still ADMIN_PASSWORD, the app prints it in a
# banner in the container log on EVERY boot, and the UI shows a warning banner,
# until you change it. Changing these values after the first boot does not
# rename or re-password the existing account -- it only affects a fresh
# database. Change the password in the UI instead, at /profile.
ADMIN_EMAIL=admin@inframonitor.local
ADMIN_PASSWORD=ChangeMe123!

# Largest WAR the Tomcat deploy endpoint accepts, in megabytes. Requests above
# this are rejected with 413 before the body is buffered. Also caps SFTP uploads.
MAX_WAR_MB=512

# Largest file the SFTP pane will download, in megabytes. Checked from the
# remote stat() before any bytes are read, so an oversize file costs nothing.
MAX_DOWNLOAD_MB=200

# --- Interactive shell limits ----------------------------------------------
# How long a shell session may run in total, in minutes. 0 = no limit.
#
# The default matches ACCESS_TOKEN_EXPIRE_MINUTES on purpose: the websocket
# token is validated once, at the handshake, and never re-checked. Without an
# absolute cap a session therefore outlives its JWT for as long as the browser
# tab stays open. Setting 0 is legitimate -- just know that is the trade.
SHELL_MAX_MINUTES=480

# Close a session after this many minutes with no traffic either way.
# 0 = no idle timeout.
SHELL_IDLE_MINUTES=30

# Concurrent shell sessions allowed across the whole install, and per user.
# NOTE the asymmetry with the two settings above: here 0 means *zero sessions
# permitted*, i.e. it disables the shell entirely, rather than "unlimited".
# A session refused by the per-user cap is told to close a tab; one refused by
# the global cap is told to wait, because the operator's fix differs.
SHELL_MAX_SESSIONS=24
SHELL_MAX_SESSIONS_PER_USER=8

# --- Rarely needed ---------------------------------------------------------
# These three have working defaults in both install modes and are listed only
# so the set is complete; leave them alone unless you have a reason.
#
#   APP_NAME    the title shown in the browser tab and the OpenAPI document.
#   STATIC_DIR  where the built UI is read from, relative to the working
#               directory. "static" in the container; scripts/native-run.ps1
#               points it at frontend/out for a native run.
#   PUBLIC_URL  only used in the default-password startup banner, so the
#               operator is told which address to go and change it at.
#
# APP_NAME=Infra Monitor
# STATIC_DIR=static
# PUBLIC_URL=http://localhost:8088

# SQLite database, relative to the container's /app working directory, where
# /app/data is the inframonitor_data volume. Change this only if you know why.
#
# FULL MODE IGNORES THIS. The overlay builds its own Postgres DSN from the
# POSTGRES_* settings in BLOCK 2, deliberately, so that this line left over
# from a lite install cannot silently send a full install back to SQLite.
DATABASE_URL=sqlite:///./data/inframonitor.db


# ===========================================================================
# BLOCK 2 -- FULL PROFILE ONLY. Ignore all of this for a lite install.
# ===========================================================================
# Full adds Postgres + Prometheus + Grafana + Loki + Promtail + Alertmanager:
#     docker compose -f docker-compose.yml -f docker-compose.full.yml up -d
#     (or: scripts/stack.sh full up)
#
# POSTGRES_PASSWORD and GRAFANA_ADMIN_PASSWORD have NO defaults. Compose refuses
# to start full mode without them. The previous stack shipped both as constants
# committed to the repo, on a Postgres published to 0.0.0.0.
#
# Generate each one with:
#     python -c "import secrets; print(secrets.token_urlsafe(24))"

# --- Postgres --------------------------------------------------------------
# In full mode the app's DATABASE_URL is assembled as
#     postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
# so POSTGRES_PASSWORD is interpolated into a URL. Keep it URL-safe: letters,
# digits, - _ . ~ (which is what the generator above produces). A password
# containing @ : / ? # needs percent-encoding and will otherwise produce a DSN
# that parses into the wrong host.
#
# Note also that Postgres only reads these at *initdb* time -- the very first
# start with an empty postgres_data volume. Changing POSTGRES_PASSWORD later
# does not change the password inside an existing volume; it just stops the app
# from being able to log in. Rotate it with ALTER ROLE inside psql instead.
POSTGRES_USER=inframonitor
POSTGRES_DB=inframonitor
POSTGRES_PASSWORD=

# --- Grafana ---------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# --- Published ports -------------------------------------------------------
# All prefixed with 1 because this host also runs ELK on 9200/5601/5044.
POSTGRES_PORT=15432
PROMETHEUS_PORT=19090
GRAFANA_PORT=13000
LOKI_PORT=13100
ALERTMANAGER_PORT=19093

# --- Exposure --------------------------------------------------------------
# Postgres is always bound to 127.0.0.1 and that is not configurable here.
#
# Prometheus, Loki and Alertmanager have no authentication of any kind, and
# Alertmanager's UI can create silences, so they are bound to 127.0.0.1 too.
# Set MONITORING_BIND=0.0.0.0 to reach them from another machine, in the
# knowledge that anyone who can reach the port has full read access to your
# metrics and logs and can silence your alerts.
MONITORING_BIND=127.0.0.1

# Grafana is the one component you actually browse to, and it does have a
# password, so it is published on all interfaces.
GRAFANA_BIND=0.0.0.0

# --- Retention -------------------------------------------------------------
# How long Prometheus keeps metrics. Loki's log retention is NOT set here --
# it is retention_period in monitoring/loki/loki.yml (168h), because Loki
# needs its compactor configured in the same file for the setting to do
# anything at all.
PROMETHEUS_RETENTION=15d

# Not set here: METRICS_ENABLED, PROMETHEUS_URL, GRAFANA_URL, LOKI_URL and
# ALERTMANAGER_URL. docker-compose.full.yml sets all five itself, to
# in-container service URLs (http://prometheus:9090 and so on) which are what
# the backend can actually reach from inside the network. Overriding them in
# .env would break the integrations panel rather than fix anything.
